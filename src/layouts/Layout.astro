---
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome"
import {
  faUpRightFromSquare,
  faMoon,
  faSun,
  faEnvelope,
  faVolumeHigh,
} from "@fortawesome/free-solid-svg-icons"
import { faGoogleScholar, faLinkedin, faResearchgate } from "@fortawesome/free-brands-svg-icons"
import { Font } from "astro:assets"
import { ClientRouter } from "astro:transitions"
import { getConfig, fullName } from "../lib/config"
import "../styles/global.css"

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
const pathname = Astro.url.pathname

const config = getConfig()
const name = fullName(config)
const footerYear = new Date().getFullYear()
const navLinks = config.nav_links

const ogKey = pathname === "/" ? "index" : pathname.replace(/^\/+|\/+$/g, "")
const ogImageURL = new URL(`/open-graph/${ogKey}.png`, Astro.url.origin).href
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content={name} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <Font cssVariable="--font-inter" preload />
    <ClientRouter />
  </head>
  <body
    class="mx-auto max-w-3xl bg-white px-5 text-lg/7 text-pretty text-gray-700 tabular-nums antialiased dark:bg-gray-900 dark:text-gray-300"
  >
    <div class="flex w-full flex-row items-start justify-between">
      <header class="flex w-full flex-col items-center gap-5 py-12 sm:flex-row sm:gap-10">
        <div class="flex w-full flex-col gap-5">
          <div class="flex w-full items-center justify-between">
            <div class="flex items-center gap-3">
              <a href="/" class="transition-transform duration-150 ease-out active:scale-[0.96]">
                <h1
                  class="mb-0 pt-0 text-center text-4xl/10 font-semibold text-gray-800 sm:text-left dark:text-gray-100"
                >
                  {config.first_name}
                  <strong class="font-black">{config.last_name}</strong>
                </h1>
              </a>

              <button
                class="flex size-9 cursor-pointer items-center justify-center text-gray-500 transition-[color,transform] duration-150 ease-out hover:text-gray-900 active:scale-[0.96] dark:text-gray-400 dark:hover:text-gray-100"
                aria-label={`Play pronunciation of ${name}`}
                title={`Play pronunciation of ${name}`}
                data-pronunciation-button
              >
                <FontAwesomeIcon icon={faVolumeHigh} className="size-5" />
              </button>
            </div>

            <button
              class="flex size-10 cursor-pointer items-center justify-center text-gray-500 transition-[color,transform] duration-150 ease-out hover:text-gray-900 active:scale-[0.96] dark:text-gray-400 dark:hover:text-gray-100"
              aria-label="Toggle Theme"
              title="Toggle Theme"
            >
              <span
                class="theme-icon light flex size-5 items-center justify-center"
                style="display:none"
              >
                <FontAwesomeIcon icon={faSun} className="size-full" />
              </span>
              <span
                class="theme-icon dark flex size-5 items-center justify-center"
                style="display:flex"
              >
                <FontAwesomeIcon icon={faMoon} className="size-full" />
              </span>
            </button>
          </div>
          <nav>
            <ul class="flex w-fit flex-wrap justify-center gap-7 text-xs/4 font-semibold">
              {
                navLinks.map(({ href, label, new_tab }) => {
                  const isActive = pathname === href || pathname === href + "/"

                  return (
                    <li>
                      <a
                        href={href}
                        target={new_tab ? "_blank" : undefined}
                        rel={new_tab ? "noopener noreferrer" : undefined}
                        class={`inline-flex items-center gap-1 transition-[color,transform,text-decoration-color] duration-150 ease-out hover:text-gray-900 active:scale-[0.96] dark:hover:text-gray-100 ${isActive ? "text-gray-900 underline decoration-gray-400 decoration-2 underline-offset-4 dark:text-gray-100 dark:decoration-gray-500" : "text-gray-500 dark:text-gray-400"}`}
                      >
                        {label}
                        {new_tab && (
                          <FontAwesomeIcon
                            icon={faUpRightFromSquare}
                            className="ml-0.5 inline-block size-2.5 opacity-70"
                          />
                        )}
                      </a>
                    </li>
                  )
                })
              }
            </ul>
          </nav>
        </div>
      </header>
    </div>

    <main class="leading-normal" transition:animate="fade">
      <slot />
    </main>

    <footer class="flex flex-col items-center gap-3 pt-5 pb-10">
      <div class="mb-3 flex justify-center gap-6">
        <a
          href={"mailto:" + config.email}
          title="email"
          class="inline-flex size-10 items-center justify-center rounded-sm text-2xl text-gray-600 transition-[color,transform] duration-150 ease-out hover:text-gray-900 active:scale-[0.96] dark:text-gray-400 dark:hover:text-gray-100"
        >
          <FontAwesomeIcon icon={faEnvelope} className="inline-block size-[1em]" />
        </a>
        <a
          href={"https://scholar.google.com/citations?user=" + config.scholar_userid}
          title="Google Scholar"
          target="_blank"
          rel="noopener noreferrer"
          class="brand-icon inline-flex size-10 items-center justify-center rounded-sm text-2xl text-gray-600 transition-[color,transform] duration-150 ease-out [--brand-color:#4285F4] active:scale-[0.96] dark:text-gray-400"
        >
          <FontAwesomeIcon icon={faGoogleScholar} />
        </a>
        <a
          href={"https://www.researchgate.net/profile/" + config.research_gate_profile + "/"}
          title="ResearchGate"
          target="_blank"
          rel="noopener noreferrer"
          class="brand-icon inline-flex size-10 items-center justify-center rounded-sm text-2xl text-gray-600 transition-[color,transform] duration-150 ease-out [--brand-color:#00CCBB] active:scale-[0.96] dark:text-gray-400"
        >
          <FontAwesomeIcon icon={faResearchgate} />
        </a>
        <a
          href={"https://www.linkedin.com/in/" + config.linkedin_username}
          title="LinkedIn"
          target="_blank"
          rel="noopener noreferrer"
          class="brand-icon inline-flex size-10 items-center justify-center rounded-sm text-2xl text-gray-600 transition-[color,transform] duration-150 ease-out [--brand-color:#0A66C2] active:scale-[0.96] dark:text-gray-400"
        >
          <FontAwesomeIcon icon={faLinkedin} />
        </a>
      </div>
      <div class="text-base text-gray-500 dark:text-gray-400">
        {config.footer_message.trim()}
      </div>
      <div class="text-xs/4 font-semibold text-gray-500 dark:text-gray-400">
        &copy; {footerYear}
        {name}. All rights reserved.
      </div>
    </footer>

    <style>
      /* Brand icons: monochrome via currentColor, brand color on hover */
      .brand-icon :global(svg) {
        display: inline-block;
        width: 1em;
        height: 1em;
        fill: currentColor;
        transition-property: fill;
        transition-duration: 150ms;
        transition-timing-function: ease-in-out;
      }

      .brand-icon :global(svg *) {
        fill: currentColor;
        transition-property: fill;
        transition-duration: 150ms;
        transition-timing-function: ease-in-out;
      }

      .brand-icon:hover :global(svg),
      .brand-icon:hover :global(svg *) {
        fill: var(--brand-color);
      }
    </style>

    <script is:inline>
      ;(() => {
        function setTheme(theme) {
          const html = document.documentElement
          const lightIcon = document.querySelector(".theme-icon.light")
          const darkIcon = document.querySelector(".theme-icon.dark")
          localStorage.setItem("theme", theme)
          if (theme === "light") {
            html.classList.remove("dark")
            if (lightIcon) lightIcon.style.display = "none"
            if (darkIcon) darkIcon.style.display = "flex"
          } else {
            html.classList.add("dark")
            if (darkIcon) darkIcon.style.display = "none"
            if (lightIcon) lightIcon.style.display = "flex"
          }
        }

        // Reveal the new theme as an expanding circle from the toggle button.
        function revealTheme(newTheme, x, y) {
          const endRadius = Math.hypot(
            Math.max(x, window.innerWidth - x),
            Math.max(y, window.innerHeight - y),
          )
          const html = document.documentElement
          html.style.setProperty("--reveal-x", x + "px")
          html.style.setProperty("--reveal-y", y + "px")
          html.style.setProperty("--reveal-radius", endRadius + "px")
          // Force the whole page into the root view-transition snapshot so the
          // radial reveal includes content inside Astro's transition groups.
          html.classList.add("theme-toggling")
          const transition = document.startViewTransition(() => setTheme(newTheme))
          transition.finished.finally(() => {
            html.classList.remove("theme-toggling")
          })
        }

        function toggleTheme(event) {
          const current = localStorage.getItem("theme") || "light"
          const newTheme = current === "light" ? "dark" : "light"

          const button = event && event.currentTarget ? event.currentTarget : null
          let x, y
          if (button && typeof button.getBoundingClientRect === "function") {
            const rect = button.getBoundingClientRect()
            x = rect.left + rect.width / 2
            y = rect.top + rect.height / 2
          } else {
            x = window.innerWidth / 2
            y = window.innerHeight / 2
          }

          const supportsTransition =
            "startViewTransition" in document &&
            !window.matchMedia("(prefers-reduced-motion: reduce)").matches

          if (supportsTransition) {
            revealTheme(newTheme, x, y)
          } else {
            setTheme(newTheme)
          }
        }

        // Runs on first load and after every Astro view-transition navigation,
        // so the (possibly re-rendered) button always gets a fresh listener and
        // the correct icon state is re-applied from the persisted theme.
        function initTheme() {
          setTheme(localStorage.getItem("theme") || "light")
          const button = document.querySelector('[aria-label="Toggle Theme"]')
          if (button) button.addEventListener("click", toggleTheme)
        }

        function initNamePronunciation() {
          const button = document.querySelector("[data-pronunciation-button]")
          if (!button || button.dataset.pronunciationReady === "true") return

          const audio = new Audio("/name.mp3")
          button.dataset.pronunciationReady = "true"
          button.addEventListener("click", () => {
            audio.currentTime = 0
            audio.play()
          })
        }

        document.addEventListener("astro:page-load", initTheme)
        document.addEventListener("astro:page-load", initNamePronunciation)
      })()
    </script>
  </body>
</html>
