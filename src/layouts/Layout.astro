---
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome"
import { faUpRightFromSquare, faMoon, faSun } from "@fortawesome/free-solid-svg-icons"
import { Font } from "astro:assets"
import { ClientRouter } from "astro:transitions"
import "../styles/global.css"

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
const pathname = Astro.url.pathname

interface NavLink {
  href: string
  label: string
  external: boolean
}

const navLinks = [
  {
    href: "/",
    label: "about",
    external: false,
  },
  {
    href: "/publications",
    label: "publications",
    external: false,
  },
  {
    href: "/cv.pdf",
    label: "CV",
    external: true,
  },
] as const satisfies NavLink[]
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <Font cssVariable="--font-inter" preload />
    <ClientRouter />
  </head>
  <body
    class="mx-auto max-w-3xl bg-white text-lg/7 text-gray-700 dark:bg-gray-900 dark:text-gray-300"
  >
    <div class="flex flex-row items-center justify-between">
      <header class="flex flex-col items-center gap-5 py-12 pt-16 sm:flex-row sm:gap-10">
        <div class="flex flex-col gap-5">
          <a href="/">
            <h1
              id="site-title"
              class="mb-0 pt-0 text-center text-4xl/10 font-semibold text-gray-800 sm:text-left dark:text-gray-100"
            >
              Kuk Jin <strong class="font-black">Jang</strong>
            </h1>
          </a>
          <nav>
            <ul class="flex w-fit flex-wrap justify-center gap-7 text-xs/4 font-semibold">
              {
                navLinks.map(({ href, label, external }) => {
                  const isActive = pathname === href || pathname === href + "/"

                  return (
                    <li>
                      <a
                        href={href}
                        target={external ? "_blank" : undefined}
                        rel={external ? "noopener noreferrer" : undefined}
                        class={`font-semibold hover:text-gray-900 dark:hover:text-gray-100 ${isActive ? "text-gray-900 underline decoration-gray-400 decoration-2 underline-offset-4 dark:text-gray-100 dark:decoration-gray-500" : "text-gray-500 dark:text-gray-400"}`}
                      >
                        {label}
                        {external && (
                          <FontAwesomeIcon
                            icon={faUpRightFromSquare}
                            className="ml-0.5 inline-block size-2.5 opacity-70"
                          />
                        )}
                      </a>
                    </li>
                  )
                })
              }
            </ul>
          </nav>
        </div>
      </header>
      <button
        class="size-6 cursor-pointer text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100"
        aria-label="Toggle Theme"
        title="Toggle Theme"
        onclick="toggleTheme()"
      >
        <span class="theme-icon light" style="display:none">
          <FontAwesomeIcon icon={faSun} className="size-full" />
        </span>
        <span class="theme-icon dark" style="display:block">
          <FontAwesomeIcon icon={faMoon} className="size-full" />
        </span>
      </button>
    </div>

    <main id="content" class="leading-normal" transition:animate="fade">
      <slot />
    </main>

    <footer class="grid gap-3 pt-5 pb-10 text-xs/4 sm:grid-cols-2">
      <div class="order-2 text-xs font-semibold text-gray-500 sm:order-1 dark:text-gray-400">
        &copy; 2024 Kuk Jin Jang. All rights reserved.
      </div>
    </footer>

    <script is:inline>
      ;(function () {
        const saved = localStorage.getItem("theme")
        const theme = saved || "light"
        setTheme(theme)
      })()

      function setTheme(theme) {
        const html = document.documentElement
        const lightIcon = document.querySelector(".theme-icon.light")
        const darkIcon = document.querySelector(".theme-icon.dark")
        localStorage.setItem("theme", theme)
        if (theme === "light") {
          html.classList.remove("dark")
          if (lightIcon) lightIcon.style.display = "none"
          if (darkIcon) darkIcon.style.display = "block"
        } else {
          html.classList.add("dark")
          if (darkIcon) darkIcon.style.display = "none"
          if (lightIcon) lightIcon.style.display = "block"
        }
      }

      // eslint-disable-next-line @typescript-eslint/no-unused-vars
      function toggleTheme() {
        const current = localStorage.getItem("theme") || "light"
        setTheme(current === "light" ? "dark" : "light")
      }
    </script>
  </body>
</html>
