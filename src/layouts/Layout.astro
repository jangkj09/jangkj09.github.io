---
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome"
import { faUpRightFromSquare, faMoon, faSun } from "@fortawesome/free-solid-svg-icons"
import { Font } from "astro:assets"
import { ClientRouter } from "astro:transitions"
import { getConfig, fullName } from "../lib/config"
import "../styles/global.css"

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
const pathname = Astro.url.pathname

const config = getConfig()
const name = fullName(config)
const footerYear = new Date().getFullYear()
const navLinks = config.nav_links

const ogKey = pathname === "/" ? "index" : pathname.replace(/^\/+|\/+$/g, "")
const ogImageURL = new URL(`/open-graph/${ogKey}.png`, Astro.url.origin).href
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content={name} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <Font cssVariable="--font-inter" preload />
    <ClientRouter />
  </head>
  <body
    class="mx-auto max-w-3xl bg-white px-5 text-lg/7 text-gray-700 dark:bg-gray-900 dark:text-gray-300"
  >
    <div class="flex flex-row items-center justify-between">
      <header class="flex flex-col items-center gap-5 py-12 pt-16 sm:flex-row sm:gap-10">
        <div class="flex flex-col gap-5">
          <a href="/">
            <h1
              id="site-title"
              class="mb-0 pt-0 text-center text-4xl/10 font-semibold text-gray-800 sm:text-left dark:text-gray-100"
            >
              {config.first_name}
              <strong class="font-black">{config.last_name}</strong>
            </h1>
          </a>
          <nav>
            <ul class="flex w-fit flex-wrap justify-center gap-7 text-xs/4 font-semibold">
              {
                navLinks.map(({ href, label, new_tab }) => {
                  const isActive = pathname === href || pathname === href + "/"

                  return (
                    <li>
                      <a
                        href={href}
                        target={new_tab ? "_blank" : undefined}
                        rel={new_tab ? "noopener noreferrer" : undefined}
                        class={`font-semibold hover:text-gray-900 dark:hover:text-gray-100 ${isActive ? "text-gray-900 underline decoration-gray-400 decoration-2 underline-offset-4 dark:text-gray-100 dark:decoration-gray-500" : "text-gray-500 dark:text-gray-400"}`}
                      >
                        {label}
                        {new_tab && (
                          <FontAwesomeIcon
                            icon={faUpRightFromSquare}
                            className="ml-0.5 inline-block size-2.5 opacity-70"
                          />
                        )}
                      </a>
                    </li>
                  )
                })
              }
            </ul>
          </nav>
        </div>
      </header>
      <button
        class="flex size-6 cursor-pointer text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100"
        aria-label="Toggle Theme"
        title="Toggle Theme"
      >
        <span
          class="theme-icon light flex size-full items-center justify-center"
          style="display:none"
        >
          <FontAwesomeIcon icon={faSun} className="size-full" />
        </span>
        <span
          class="theme-icon dark flex size-full items-center justify-center"
          style="display:flex"
        >
          <FontAwesomeIcon icon={faMoon} className="size-full" />
        </span>
      </button>
    </div>

    <main id="content" class="leading-normal" transition:animate="fade">
      <slot />
    </main>

    <footer class="grid gap-3 pt-5 pb-10 text-xs/4 sm:grid-cols-2">
      <div class="order-2 font-semibold text-gray-500 sm:order-1 dark:text-gray-400">
        &copy; {footerYear}
        {name}. All rights reserved.
      </div>
    </footer>

    <script is:inline>
      ;(() => {
        function setTheme(theme) {
          const html = document.documentElement
          const lightIcon = document.querySelector(".theme-icon.light")
          const darkIcon = document.querySelector(".theme-icon.dark")
          localStorage.setItem("theme", theme)
          if (theme === "light") {
            html.classList.remove("dark")
            if (lightIcon) lightIcon.style.display = "none"
            if (darkIcon) darkIcon.style.display = "flex"
          } else {
            html.classList.add("dark")
            if (darkIcon) darkIcon.style.display = "none"
            if (lightIcon) lightIcon.style.display = "flex"
          }
        }

        // Reveal the new theme as an expanding circle from the toggle button.
        function revealTheme(newTheme, x, y) {
          const endRadius = Math.hypot(
            Math.max(x, window.innerWidth - x),
            Math.max(y, window.innerHeight - y),
          )
          const html = document.documentElement
          html.style.setProperty("--reveal-x", x + "px")
          html.style.setProperty("--reveal-y", y + "px")
          html.style.setProperty("--reveal-radius", endRadius + "px")
          document.startViewTransition(() => setTheme(newTheme))
        }

        function toggleTheme(event) {
          const current = localStorage.getItem("theme") || "light"
          const newTheme = current === "light" ? "dark" : "light"

          const button = event && event.currentTarget ? event.currentTarget : null
          let x, y
          if (button && typeof button.getBoundingClientRect === "function") {
            const rect = button.getBoundingClientRect()
            x = rect.left + rect.width / 2
            y = rect.top + rect.height / 2
          } else {
            x = window.innerWidth / 2
            y = window.innerHeight / 2
          }

          const supportsTransition =
            "startViewTransition" in document &&
            !window.matchMedia("(prefers-reduced-motion: reduce)").matches

          if (supportsTransition) {
            revealTheme(newTheme, x, y)
          } else {
            setTheme(newTheme)
          }
        }

        // Runs on first load and after every Astro view-transition navigation,
        // so the (possibly re-rendered) button always gets a fresh listener and
        // the correct icon state is re-applied from the persisted theme.
        function initTheme() {
          setTheme(localStorage.getItem("theme") || "light")
          const button = document.querySelector('[aria-label="Toggle Theme"]')
          if (button) button.addEventListener("click", toggleTheme)
        }

        document.addEventListener("astro:page-load", initTheme)
      })()
    </script>
  </body>
</html>
