---
import Layout from "../layouts/Layout.astro"
import { getConfig, fullName } from "../lib/config"

const name = fullName(getConfig())
---

<Layout title={`404 — ${name}`} description="Page not found.">
  <section class="flex min-h-[50vh] flex-col items-center justify-center gap-4 py-12 text-center">
    <p class="text-7xl font-black text-gray-800 dark:text-gray-100">404</p>
    <h2 class="text-2xl/8 font-extrabold text-gray-900 dark:text-gray-300">page not found</h2>
    <p class="max-w-md text-base text-gray-500 dark:text-gray-400">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <a
      href="/"
      class="mt-2 font-semibold text-emerald-700 underline decoration-gray-400 decoration-2 underline-offset-4 hover:text-emerald-600 dark:text-emerald-300 dark:decoration-gray-500 dark:hover:text-emerald-200"
    >
      Back home
    </a>
  </section>
</Layout>
