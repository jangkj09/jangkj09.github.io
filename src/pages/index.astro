---
import { getCollection, getEntry, render } from "astro:content"
import { faGoogleScholar, faLinkedin, faResearchgate } from "@fortawesome/free-brands-svg-icons"
import { faArrowRight, faEnvelope } from "@fortawesome/free-solid-svg-icons"
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome"
import PublicationCard from "../components/PublicationCard.astro"
import Layout from "../layouts/Layout.astro"
import { getConfig, fullName } from "../lib/config"
import { getSelectedPapers } from "../lib/papers"

const config = getConfig()

const { Content: Bio } = await render(await getEntry("bio", "bio")!)

const newsEntries = (await getCollection("news")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
)

const selectedPapers = getSelectedPapers()

const newsItems = await Promise.all(
  newsEntries.map(async (entry) => {
    const { Content } = await render(entry)
    return { entry, Content }
  }),
)

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "2-digit",
  year: "numeric",
})
---

<Layout title={fullName(config)} description={config.description.trim()}>
  <section class="pb-4">
    <div class="flex flex-col-reverse gap-6 sm:flex-row">
      <div>
        <p class="mb-4 text-base text-gray-500">
          <a
            href={config.affiliation.url}
            target="_blank"
            rel="noopener noreferrer"
            class="font-bold text-emerald-700 underline hover:text-emerald-600 dark:text-emerald-300 dark:hover:text-emerald-200"
          >
            {config.affiliation.name}
          </a>
          <span class="mt-1 block">{config.email}</span>
        </p>
        <div class="[&_p]:mb-4">
          <Bio />
        </div>
      </div>
      <div class="mx-auto w-full max-w-70 shrink-0 sm:mx-0 sm:w-50">
        <img
          src="/profile.webp"
          alt={fullName(config) + " profile picture"}
          width="100%"
          height="auto"
          class="rounded-sm"
        />
      </div>
    </div>
  </section>

  <hr class="my-6 border-gray-200 dark:border-gray-700" />

  <section class="pb-4">
    <h2 class="mb-4 pt-0 text-2xl/8 font-extrabold text-gray-900 dark:text-gray-300">news</h2>
    <div class="flex flex-col gap-3">
      {
        newsItems.map(({ entry, Content }) => (
          <div class="flex flex-col gap-1 text-base/6 sm:flex-row sm:gap-4">
            <span class="min-w-30 text-sm font-semibold whitespace-nowrap text-gray-600 dark:text-gray-400">
              {dateFormatter.format(entry.data.date)}
            </span>
            <div class="text-gray-700 dark:text-gray-300 [&_p]:my-0">
              <Content />
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <hr class="my-6 border-gray-200 dark:border-gray-700" />

  <section id="publications" class="pb-4">
    <div class="mb-4 flex items-baseline justify-start gap-2">
      <h2 class="pt-0 text-2xl/8 font-extrabold text-gray-900 dark:text-gray-300">
        selected publications
      </h2>
      <a
        href="/publications"
        class="group text-sm font-medium text-emerald-700 hover:text-emerald-600 dark:text-emerald-300 dark:hover:text-emerald-200"
        >see more <FontAwesomeIcon
          icon={faArrowRight}
          className="ml-1 inline-block size-[1em] transition-[margin] duration-150 ease-out group-hover:ml-2"
        /></a
      >
    </div>
    <div class="flex flex-col gap-6">
      {selectedPapers.map((paper) => <PublicationCard paper={paper} compact />)}
    </div>
  </section>

  <hr class="my-6 border-gray-200 dark:border-gray-700" />

  <section class="pb-8 text-center">
    <div class="mb-3 flex justify-center gap-6">
      <a
        href={"mailto:" + config.email}
        title="email"
        class="text-2xl text-gray-600 no-underline hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100"
      >
        <FontAwesomeIcon icon={faEnvelope} className="inline-block size-[1em]" />
      </a>
      <a
        href={"https://scholar.google.com/citations?user=" + config.scholar_userid}
        title="Google Scholar"
        target="_blank"
        rel="noopener noreferrer"
        class="brand-icon text-2xl text-gray-600 no-underline [--brand-color:#4285F4] dark:text-gray-400"
      >
        <FontAwesomeIcon icon={faGoogleScholar} />
      </a>
      <a
        href={"https://www.researchgate.net/profile/" + config.research_gate_profile + "/"}
        title="ResearchGate"
        target="_blank"
        rel="noopener noreferrer"
        class="brand-icon text-2xl text-gray-600 no-underline [--brand-color:#00CCBB] dark:text-gray-400"
      >
        <FontAwesomeIcon icon={faResearchgate} />
      </a>
      <a
        href={"https://www.linkedin.com/in/" + config.linkedin_username}
        title="LinkedIn"
        target="_blank"
        rel="noopener noreferrer"
        class="brand-icon text-2xl text-gray-600 no-underline [--brand-color:#0A66C2] dark:text-gray-400"
      >
        <FontAwesomeIcon icon={faLinkedin} />
      </a>
    </div>
    <div class="text-base text-gray-500 dark:text-gray-400">
      {config.content_note.trim()}
    </div>
  </section>
</Layout>

<style>
  /* Brand icons: monochrome via currentColor, brand color on hover */
  .brand-icon :global(svg) {
    display: inline-block;
    width: 1em;
    height: 1em;
    fill: currentColor;
    transition: fill 0.15s ease-in-out;
  }

  .brand-icon :global(svg *) {
    fill: currentColor;
    transition: fill 0.15s ease-in-out;
  }

  .brand-icon:hover :global(svg),
  .brand-icon:hover :global(svg *) {
    fill: var(--brand-color);
  }
</style>
