---
import fs from "node:fs"
import { getCollection, render } from "astro:content"
import YAML from "yaml"
import PublicationCard from "../components/PublicationCard.astro"
import Layout from "../layouts/Layout.astro"
import { getSelectedPapers } from "../lib/papers"

type Config = {
  first_name: string
  last_name: string
  email: string

  linkedin_username: string
  research_gate_profile: string
  scholar_userid: string

  description: string
  content_note: string
}

const config: Config = YAML.parse(fs.readFileSync("src/content/config.yaml", "utf-8"))

const newsEntries = (await getCollection("news")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
)

const selectedPapers = getSelectedPapers()

const newsItems = await Promise.all(
  newsEntries.map(async (entry) => {
    const { Content } = await render(entry)
    return { entry, Content }
  }),
)

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "2-digit",
  year: "numeric",
})
---

<Layout title={config.first_name + " " + config.last_name} description={config.description.trim()}>
  <section class="pb-4">
    <div class="flex flex-col-reverse gap-6 sm:flex-row">
      <div>
        <p class="mb-4 text-base text-gray-500">
          <a
            href="https://precise.seas.upenn.edu/"
            target="_blank"
            rel="noopener noreferrer"
            class="font-bold text-emerald-700 underline hover:text-emerald-600 dark:text-emerald-300 dark:hover:text-emerald-200"
          >
            PRECISE University of Pennsylvania
          </a>
          <span class="mt-1 block">{config.email}</span>
        </p>
        <p class="mb-4">
          Machine learning researcher specializing in trustworthy AI, multimodal learning, and
          uncertainty quantification for healthcare and robotics applications. Recently, I have
          focused on building trustworthy and reliable systems based on generative AI. With a Ph.D.
          in Electrical and Systems Engineering and over 30 publications, my work spans robust ECG
          classification, AI for ophthalmology and oculomics, and clinical interaction analysis.
        </p>
        <p class="mb-4">
          I am committed to advancing AI in medicine and health, actively mentoring students, and
          contributing to the academic community and industry.
        </p>
      </div>
      <div class="mx-auto w-full max-w-70 shrink-0 sm:mx-0 sm:w-50">
        <img
          src="/profile.webp"
          alt={config.first_name + " " + config.last_name + " profile picture"}
          width="100%"
          height="auto"
          class="rounded-sm"
        />
      </div>
    </div>
  </section>

  <hr class="my-6 border-gray-200 dark:border-gray-700" />

  <section class="pb-4">
    <h2 class="mb-4 pt-0 text-2xl/8 font-extrabold text-gray-900 dark:text-gray-300">news</h2>
    <div class="flex flex-col gap-3">
      {
        newsItems.map(({ entry, Content }) => (
          <div class="flex flex-col gap-1 text-base/6 sm:flex-row sm:gap-4">
            <span class="min-w-30 text-sm font-semibold whitespace-nowrap text-gray-600 dark:text-gray-400">
              {dateFormatter.format(entry.data.date)}
            </span>
            <div class="text-gray-700 dark:text-gray-300 [&_p]:my-0">
              <Content />
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <hr class="my-6 border-gray-200 dark:border-gray-700" />

  <section id="publications" class="pb-4">
    <h2 class="mb-4 pt-0 text-2xl/8 font-extrabold text-gray-900 dark:text-gray-300">
      selected publications
    </h2>
    <div class="flex flex-col gap-6">
      {selectedPapers.map((paper) => <PublicationCard paper={paper} compact />)}
    </div>
  </section>

  <hr class="my-6 border-gray-200 dark:border-gray-700" />

  <section class="pb-8 text-center">
    <div class="mb-3 flex justify-center gap-6">
      <a
        href={"mailto:" + config.email}
        title="email"
        class="text-2xl text-gray-600 no-underline hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100"
      >
        <i class="fa-solid fa-envelope"></i>
      </a>
      <a
        href={"https://scholar.google.com/citations?user=" + config.scholar_userid}
        title="Google Scholar"
        target="_blank"
        rel="noopener noreferrer"
        class="text-2xl text-gray-600 no-underline hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100"
      >
        <i class="ai ai-google-scholar"></i>
      </a>
      <a
        href={"https://www.researchgate.net/profile/" + config.research_gate_profile + "/"}
        title="ResearchGate"
        target="_blank"
        rel="noopener noreferrer"
        class="text-2xl text-gray-600 no-underline hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100"
      >
        <i class="ai ai-researchgate"></i>
      </a>
      <a
        href={"https://www.linkedin.com/in/" + config.linkedin_username}
        title="LinkedIn"
        target="_blank"
        rel="noopener noreferrer"
        class="text-2xl text-gray-600 no-underline hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100"
      >
        <i class="fa-brands fa-linkedin"></i>
      </a>
    </div>
    <div class="text-base text-gray-500 dark:text-gray-400">
      {config.content_note.trim()}
    </div>
  </section>
</Layout>
