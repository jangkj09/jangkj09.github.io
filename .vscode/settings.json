{
  "editor.formatOnSave": true,
  "editor.rulers": [100],
  "files.associations": {
    "*.css": "tailwindcss"
  },

  "[json][jsonc][yaml][markdown][javascript][typescript][astro][github-actions-workflow]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  "cSpell.words": [
    "bibtex",
    "booktitle",
    "inproceedings",
    "Jang",
    "Kukjin",
    "kukjinjang",
    "Stylesheet",
    "trivago"
  ]
}
